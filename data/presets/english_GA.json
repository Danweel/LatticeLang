  "constraint_details": {
    "sonority_sequencing": {
      "description": "Sonority must rise toward the nucleus and fall away from it within each syllable.",
      "type": "built_in"
    },
    "allow_s_appendix": {
      "description": "/s/ may appear as the first consonant in an onset cluster, preceding any consonant regardless of sonority (e.g., /sp/, /st/, /sk/, /sm/, /sn/, /sl/, /sw/).",
      "type": "built_in",
      "appendix_phoneme": "s",
      "allowed_followers": ["p", "t", "k", "m", "n", "l", "ɹ", "w", "j"]
    },
    "no_geminate_obstruents": {
      "description": "The same obstruent (stop or fricative) cannot appear twice consecutively within a single syllable.",
      "type": "built_in"
    },
    "max_onset_length_3": {
      "description": "Maximum of 3 consonants in the onset (only achievable with s + voiceless stop + liquid).",
      "type": "built_in",
      "max_length": 3
    },
    "max_coda_length_4": {
      "description": "Maximum of 4 consonants in the coda (e.g., /ksθs/ in 'sixths').",
      "type": "built_in",
      "max_length": 4
    },
    "s_appendix_restricts_position_2": {
      "description": "When /s/ is the first onset consonant, position 2 must be a voiceless stop (/p/, /t/, /k/), nasal (/m/, /n/), liquid (/l/, /ɹ/), or glide (/w/, /j/).",
      "type": "built_in"
    },
    "no_ng_onset": {
      "description": "/ŋ/ cannot appear in syllable-initial position (only in coda).",
      "type": "built_in",
      "forbidden_onset_phonemes": ["ŋ"]
    },
    "no_h_coda": {
      "description": "/h/ cannot appear in syllable-final position (coda).",
      "type": "built_in",
      "forbidden_coda_phonemes": ["h"]
    }
  },
